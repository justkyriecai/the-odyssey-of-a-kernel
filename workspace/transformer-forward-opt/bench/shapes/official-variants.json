    "batch_size": 64,
    "seq_len": 128,
    "d_model": 128,
    "num_heads": 4,
    "ffn_dim": 128,
    "num_layers": 4,
    "causal": true,
    "dtype": "float32",
    "padding_ratio": 0.0,
    "input_scale": 1.0
  },
  "cases": [
